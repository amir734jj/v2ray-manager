doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(http-equiv="refresh" content="5")
    title Gateway status
    style
      include status.css
  body
    h1 Gateway status
    p Read-only live connection counters &middot; refreshes every 5 seconds
    section.cards(aria-label="Connection totals")
      .card
        | Active tunnels
        strong.live= totals.active
      .card
        | Total attempts
        strong= totals.total
      .card
        | Proxy errors
        strong= totals.errors
    .table-wrap
      table
        thead
          tr
            each heading in ['Protocol', 'Transport', 'Active', 'Total', 'Errors']
              th= heading
        tbody
          each row in connections
            tr
              td= row.protocol
              td= row.transport.toUpperCase()
              td= row.active
              td= row.total
              td= row.errors
    footer
      p
        | Started #{startedAt} &middot; Uptime #{uptimeSeconds}s &middot; 
        a(href="/status.json") JSON snapshot
      p.
        Counts reset on restart and belong to this gateway process only. Attempts include failed connections.
        Active means an open routed socket or stream, not an authenticated user or successful browsing.
        Health checks and status visits are excluded. No client identities or destinations are displayed.

doctype html
html(lang="en" data-bs-theme="dark")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(http-equiv="refresh" content="5")
    title Gateway status
    style!= bootstrapCss
  body
    main.container.py-5
      h1 Gateway status
      p.text-body-secondary Read-only live connection counters &middot; refreshes every 5 seconds
      section.row.g-3.my-4(aria-label="Connection totals")
        each card in [{ label: 'Open client sockets', value: totals.active, color: 'text-success' }, { label: 'Connection attempts', value: totals.total, color: '' }, { label: 'Proxy failures', value: totals.errors, color: 'text-danger' }]
          .col-12.col-sm-4
            .card.h-100
              .card-body
                p.card-title.text-body-secondary= card.label
                strong.fs-2(class=card.color)= card.value
      .table-responsive
        table.table.table-striped.align-middle
          thead
            tr
              th(scope="col") Protocol
              th(scope="col") Transport
              each heading in ['Open client sockets', 'Connection attempts', 'Proxy failures']
                th.text-end(scope="col")= heading
          tbody
            each row in connections
              tr
                th(scope="row")= row.protocol
                td= row.transport.toUpperCase()
                td.text-end= row.active
                td.text-end= row.total
                td.text-end= row.errors
      h2.h4.mt-4#active-clients Active clients by IP
      p.text-body-secondary
        | One group per IP, not per person or device. Expand a group to see its individual sockets.
        |  The selected group stays open across refreshes. User-Agent may be missing or spoofed and does not reliably identify a device model.
        |  IPs and client details are also exposed in the JSON snapshot.
      .table-responsive
        table.table.table-striped.align-middle
          thead
            tr
              each heading in ['IP address', 'Country', 'Protocols', 'Open client sockets', 'Details']
                th(scope="col")= heading
          tbody
            each group in clientGroups
              tr
                th(scope="row")= group.ip
                td= group.countries.map(country => `${country.name} (${country.code})`).join(', ')
                td= group.protocols.join(', ')
                td.text-end= group.active
                td
                  a.btn.btn-sm.btn-outline-secondary(href=group.ip === expandedIp ? `${statusPath}#active-clients` : `${statusPath}?client=${encodeURIComponent(group.ip)}#active-clients` aria-expanded=group.ip === expandedIp)= group.ip === expandedIp ? 'Hide connections' : 'View connections'
              if group.ip === expandedIp
                tr
                  td(colspan="5")
                    .table-responsive
                      table.table.table-striped.align-middle.mb-0
                        thead
                          tr
                            each heading in ['Connection ID', 'Protocol', 'Country', 'Reported client (User-Agent)', 'Connected since (UTC)', 'Open for (seconds)']
                              th(scope="col")= heading
                        tbody
                          each client in clients.filter(client => client.ip === group.ip)
                            tr
                              th.text-break(scope="row")= client.connectionId
                              td= client.protocol
                              td #{client.countryName} (#{client.countryCode})
                              td.text-break= client.userAgent
                              td.text-nowrap= client.connectedAt
                              td.text-end= client.elapsedSeconds
            if clientGroups.length === 0
              tr
                td.text-body-secondary(colspan="5") No active client connections.
      h2.h4.mt-4 Connections by country
      p.text-body-secondary Based on trusted Cloudflare metadata; unavailable values appear as Unknown.
      .table-responsive
        table.table.table-striped.align-middle
          thead
            tr
              th(scope="col") Country
              th(scope="col") Code
              each heading in ['Open client sockets', 'Connection attempts', 'Proxy failures']
                th.text-end(scope="col")= heading
          tbody
            each row in countries
              tr
                th(scope="row")= row.name
                td= row.code
                td.text-end= row.active
                td.text-end= row.total
                td.text-end= row.errors
            if countries.length === 0
              tr
                td.text-body-secondary(colspan="5") No connections yet.
      footer.mt-4.small.text-body-secondary
        p
          | Started #{startedAt} &middot; Uptime #{uptimeSeconds}s &middot;&nbsp;
          a(href="/status.json") JSON snapshot
        p.
          Counts reset on restart and belong to this gateway process only. Connection attempts include probes, reconnects, and failed connections.
          Open client sockets are routed client connections, not authenticated users or proof of successful browsing.
          Proxy failures count attempts reported by the proxy error handler, not all authentication or browsing failures.
          Health checks and status visits are excluded. Active client details disappear when sockets close.
          IPs may be shared by multiple people or devices; credentials and destinations are not displayed.

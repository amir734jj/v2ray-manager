{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "udp": true }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "YOUR_SERVER_IP",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "alterId": 0,
                "security": "auto"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": { "serverName": "YOUR_SERVER_IP" },
        "wsSettings": { "path": "/vmess", "headers": { "Host": "YOUR_SERVER_IP" } }
      },
      "mux": { "enabled": false }
    },
    { "tag": "direct",  "protocol": "freedom" },
    { "tag": "blocked", "protocol": "blackhole" }
  ],
  "dns": { "servers": ["1.1.1.1", "8.8.8.8"] },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [{ "type": "field", "ip": ["geoip:private"], "outboundTag": "direct" }]
  }
}

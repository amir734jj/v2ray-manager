{
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "YOUR_SERVER_IP",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": { "serverName": "YOUR_SERVER_IP" },
        "wsSettings": { "path": "/vless", "headers": { "Host": "YOUR_SERVER_IP" } }
      },
      "mux": { "enabled": false }
    },
    {
      "tag": "vmess",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "YOUR_SERVER_IP",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "alterId": 0,
                "security": "auto"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": { "serverName": "YOUR_SERVER_IP" },
        "wsSettings": { "path": "/vmess", "headers": { "Host": "YOUR_SERVER_IP" } }
      },
      "mux": { "enabled": false }
    },
    {
      "tag": "trojan",
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "YOUR_SERVER_IP",
            "port": 443,
            "password": "00000000-0000-0000-0000-000000000000"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": { "serverName": "YOUR_SERVER_IP" },
        "wsSettings": { "path": "/trojan", "headers": { "Host": "YOUR_SERVER_IP" } }
      },
      "mux": { "enabled": false }
    },
    {
      "tag": "shadowsocks",
      "protocol": "shadowsocks",
      "settings": {
        "servers": [
          {
            "address": "YOUR_SERVER_IP",
            "port": 443,
            "method": "aes-256-gcm",
            "password": "00000000-0000-0000-0000-000000000000"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": { "serverName": "YOUR_SERVER_IP" },
        "wsSettings": { "path": "/shadowsocks", "headers": { "Host": "YOUR_SERVER_IP" } }
      },
      "mux": { "enabled": false }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "blocked",
      "protocol": "blackhole"
    }
  ],
  "dns": {
    "servers": ["1.1.1.1", "8.8.8.8"]
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "direct"      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "vless"      }
    ]
  }
}

{
  "inbounds": [
    {
      "tag": "shadowsocks-socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "udp": true }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "shadowsocks",
      "settings": {
        "servers": [
          {
            "address": "YOUR_SERVER_IP",
            "port": 443,
            "method": "aes-256-gcm",
            "password": "00000000-0000-0000-0000-000000000000"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": { "serverName": "YOUR_SERVER_IP" },
        "wsSettings": { "path": "/shadowsocks", "headers": { "Host": "YOUR_SERVER_IP" } }
      },
      "mux": { "enabled": false }
    },
    { "tag": "direct",  "protocol": "freedom" },
    { "tag": "blocked", "protocol": "blackhole" },
    {
      "tag": "shadowsocks-dns",
      "protocol": "dns",
      "settings": { "network": "tcp", "address": "1.1.1.1", "port": 53 },
      "proxySettings": { "tag": "proxy" }
    },
    { "tag": "shadowsocks-udp-blocked", "protocol": "blackhole" }
  ],
  "dns": {
    "servers": [
      {
        "address": "https+local://1.1.1.1/dns-query",
        "domains": ["full:YOUR_SERVER_IP"],
        "skipFallback": true
      },
      "tcp://1.1.1.1"
    ],
    "tag": "shadowsocks-dns-query",
    "disableFallbackIfMatch": true
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      { "type": "field", "inboundTag": ["shadowsocks-dns-query"], "outboundTag": "proxy" },
      { "type": "field", "inboundTag": ["shadowsocks-socks"], "network": "tcp,udp", "port": "53", "outboundTag": "shadowsocks-dns" },
      { "type": "field", "inboundTag": ["shadowsocks-socks"], "network": "udp", "outboundTag": "shadowsocks-udp-blocked" },
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "direct" }
    ]
  }
}
